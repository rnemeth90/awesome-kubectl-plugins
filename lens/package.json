{
  "name": "@rnemeth90/kubectl-plugins-freelens",
  "version": "0.1.0",
  "description": "Freelens/Lens extension that runs the kubectl-plugins tools against the open cluster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnemeth90/awesome-kubectl-plugins.git",
    "directory": "lens"
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "license": "MIT",
