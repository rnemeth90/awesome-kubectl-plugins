    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
